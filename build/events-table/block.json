{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "tec-events-carousel/events-table",
  "version": "0.2.0",
  "title": "Events Table",
  "category": "widgets",
  "icon": "calendar-alt",
  "description": "Display events from The Events Calendar in a compact table.",
  "attributes": {
    "numberOfEvents": {
      "type": "number",
      "default": 6
    },
    "eventOrder": {
      "type": "string",
      "default": "upcoming"
    },
    "eventCategories": {
      "type": "array",
      "default": [],
      "items": {
        "type": "number"
      }
    },
    "eventTags": {
      "type": "array",
      "default": [],
      "items": {
        "type": "number"
      }
    },
    "sectionTitle": {
      "type": "string",
      "default": "Upcoming Events"
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "textdomain": "tec-events-carousel",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}